rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function verifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isMember(propertyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)/members/$(request.auth.uid));
    }
    // Inlined as a single exists()-guarded chain (not isMember() + a second
    // get()-based function) — splitting the exists() guard and the get().data
    // dereference across two separate function calls does not reliably
    // short-circuit, and throws instead of returning false for a
    // non-member/non-existent property during a `list` query.
    function isOwner(propertyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/properties/$(propertyId)/members/$(request.auth.uid)).data.role == 'owner';
    }
    function hasPendingInvite(propertyId) {
      return verifiedEmail() &&
        exists(/databases/$(database)/documents/invites/$(propertyId + '__' + myEmail())) &&
        get(/databases/$(database)/documents/invites/$(propertyId + '__' + myEmail())).data.status == 'pending';
    }
    function hasPendingTransfer(propertyId) {
      return verifiedEmail() &&
        exists(/databases/$(database)/documents/transferRequests/$(propertyId + '__' + myEmail())) &&
        get(/databases/$(database)/documents/transferRequests/$(propertyId + '__' + myEmail())).data.status == 'pending';
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      // Denormalized index: "which properties do I belong to".
      match /memberships/{propertyId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && (request.auth.uid == uid || hasPendingTransfer(propertyId));
      }
    }

    // ---------- properties ----------
    match /properties/{propertyId} {
      allow read: if isMember(propertyId) || hasPendingInvite(propertyId) || hasPendingTransfer(propertyId);

      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Owner can edit name/address. A buyer accepting a pending transfer may
      // only flip ownerUid/ownerEmail — nothing else.
      allow update: if
        (isOwner(propertyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'pendingTransferId'])) ||
        (hasPendingTransfer(propertyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'ownerEmail', 'pendingTransferId']));

      allow delete: if isOwner(propertyId);

      match /members/{memberUid} {
        allow read: if isMember(propertyId) || hasPendingInvite(propertyId) || hasPendingTransfer(propertyId);

        allow create: if isSignedIn() && memberUid == request.auth.uid && (
          // Claiming the owner slot on a brand-new property (it doesn't exist yet).
          (request.resource.data.role == 'owner' &&
            !exists(/databases/$(database)/documents/properties/$(propertyId))) ||
          // Buyer accepting a pending ownership transfer.
          (request.resource.data.role == 'owner' && hasPendingTransfer(propertyId)) ||
          // Invitee accepting a pending view-only invite.
          (request.resource.data.role == 'viewer' && hasPendingInvite(propertyId))
        );

        allow delete: if isOwner(propertyId) || memberUid == request.auth.uid || hasPendingTransfer(propertyId);
        allow update: if false;
      }

      match /rooms/{roomId} {
        allow read: if isMember(propertyId);
        allow write: if isOwner(propertyId);
      }

      match /equipment/{equipmentId} {
        allow read: if isMember(propertyId);
        allow write: if isOwner(propertyId);
      }

      // Path-scoped mirror of outstanding invites, purely so the owner can
      // list "who have I invited" via a plain subcollection read (the same
      // safe shape as rooms/equipment) instead of a content-filtered query
      // against the top-level invites collection, whose rule necessarily
      // depends on resource.data — a shape that query planners (and in
      // particular the local emulator) can require evaluating against a
      // broader candidate set than the query's own filter would return.
      match /pendingInvites/{email} {
        allow read: if isMember(propertyId);
        allow create: if isOwner(propertyId);
        allow delete: if isOwner(propertyId) || (verifiedEmail() && email == myEmail());
        allow update: if false;
      }
    }

    // ---------- invites (family, view-only) ----------
    match /invites/{inviteId} {
      // `resource != null` guard first, then .get(field, default) instead of
      // dot-access: a filtered `list` query against a collection with zero
      // matching (or zero total) documents still evaluates this rule once
      // with no real document behind it, and dereferencing resource.data or
      // a missing field throws instead of just failing the check.
      allow read: if resource != null && isSignedIn() && (
        (verifiedEmail() && resource.data.get('email', null) == myEmail()) ||
        isOwner(resource.data.get('propertyId', 'none'))
      );

      allow create: if isSignedIn() &&
        isOwner(request.resource.data.propertyId) &&
        inviteId == request.resource.data.propertyId + '__' + request.resource.data.email &&
        request.resource.data.status == 'pending';

      // Only the invited (verified) email can flip pending -> accepted, and
      // only that one field (plus a timestamp) may change.
      allow update: if isSignedIn() && verifiedEmail() &&
        resource.data.email == myEmail() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);

      // Owner can revoke; the invited (verified) email can decline.
      allow delete: if isOwner(resource.data.propertyId) ||
        (verifiedEmail() && resource.data.email == myEmail());
    }

    // ---------- ownership transfer ----------
    match /transferRequests/{transferId} {
      allow read: if resource != null && isSignedIn() && (
        (verifiedEmail() && resource.data.get('toEmail', null) == myEmail()) ||
        isOwner(resource.data.get('propertyId', 'none'))
      );

      allow create: if isSignedIn() &&
        isOwner(request.resource.data.propertyId) &&
        request.resource.data.fromUid == request.auth.uid &&
        transferId == request.resource.data.propertyId + '__' + request.resource.data.toEmail &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() && verifiedEmail() &&
        resource.data.toEmail == myEmail() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);

      // Owner can cancel a still-pending transfer; the named buyer can decline it.
      allow delete: if (isOwner(resource.data.propertyId) && resource.data.status == 'pending') ||
        (verifiedEmail() && resource.data.toEmail == myEmail());
    }
  }
}
